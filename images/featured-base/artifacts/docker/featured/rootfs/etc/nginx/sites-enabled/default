server {
    # Auth, redirects, logging, /ssh, /health and the landing page.
    include snippets/idekube-server.conf;
    include snippets/idekube-coder.conf;

    # VNC via noVNC
    location = /vnc {
        auth_request /_idekube_auth;
        return 301 /vnc/;
    }
    location ~ ^/vnc/(.*)$ {
        auth_request /_idekube_auth;
        proxy_pass http://127.0.0.1:6081/$1;
    }
    location = /vnc/websockify {
        auth_request /_idekube_auth;
        proxy_pass http://127.0.0.1:6081/websockify;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
    }
}
