server {
    # Auth, redirects, logging, /ssh, /health and the landing page.
    include snippets/idekube-server.conf;

    # Jupyter
    location = /jupyter {
        auth_request /_idekube_auth;
        return 301 /jupyter/;
    }
    location /jupyter/ {
        auth_request /_idekube_auth;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400;
        proxy_pass http://127.0.0.1:8888;
    }
}
